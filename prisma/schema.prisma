generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Utilisable en local instantané ou commutable en "postgresql" pour Supabase
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  nom          String
  login        String   @unique
  telephone    String?  @unique
  email        String?  @unique
  motDePasse   String   @default("123456") @map("mot_de_passe")
  profil       String?
  role         String   @default("VENDEUR") // ADMIN, GERANT, VENDEUR
  active       Boolean  @default(true)
  pointVenteId Int?     @map("point_vente_id")
  ville        String?  @default("Bamako")
  dateCreation DateTime @default(now()) @map("date_creation")
  updatedAt    DateTime @updatedAt @map("updated_at")

  pointVenteDefaut     PointDeVente?    @relation("UserPointVente", fields: [pointVenteId], references: [id])
  pointsDeVenteGerance PointDeVente[]   @relation("PointGerant")
  ventes               Vente[]
  achats               Achat[]
  factures             Facture[]
  paiementsRecus       PaiementDette[]
  mouvementsStock      StockMouvement[]
  cloturesCaisse       ClotureCaisse[]
  depenses             Depense[]
  transfertsInities    TransfertStock[] @relation("TransfertInitiePar")
  transfertsValides    TransfertStock[] @relation("TransfertValidePar")

  @@map("utilisateurs")
}

model PointDeVente {
  id           Int      @id @default(autoincrement())
  nom          String
  codeBoutique String   @unique @map("code_boutique") // Ex: BAM-01, SIK-01, SEG-01
  ville        String   @default("Bamako") // Bamako, Sikasso, Ségou, Kayes, etc.
  adresse      String?
  telephone    String?
  email        String?
  gerantId     Int?     @map("gerant_id")
  active       Boolean  @default(true)
  dateCreation DateTime @default(now()) @map("date_creation")
  updatedAt    DateTime @updatedAt @map("updated_at")

  gerant               User?            @relation("PointGerant", fields: [gerantId], references: [id])
  vendeurs             User[]           @relation("UserPointVente")
  stocks               StockParPoint[]
  ventes               Vente[]
  achats               Achat[]
  factures             Facture[]
  mouvementsStock      StockMouvement[]
  cloturesCaisse       ClotureCaisse[]
  depenses             Depense[]
  transfertsExpedies   TransfertStock[] @relation("TransfertOrigine")
  transfertsReceptionnes TransfertStock[] @relation("TransfertDestination")

  @@map("point_de_vente")
}

model Categorie {
  id          Int       @id @default(autoincrement())
  nom         String    @unique
  slug        String    @unique
  description String?
  image       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  produits    Produit[]

  @@map("categories")
}

model Produit {
  id           Int       @id @default(autoincrement())
  nom          String
  ref          String?   @unique
  description  String?
  typeArticle  String    @default("MARCHANDISE") @map("type_article") // MARCHANDISE, PRESTATION_SERVICE, FOURNITURE
  categorieId  Int?      @map("categorie_id")
  categorieNom String?   @map("categorie_nom")
  imageUrl     String?   @map("image_url")
  actif        Boolean   @default(true)
  dateAjout    DateTime  @default(now()) @map("date_ajout")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  categorie   Categorie?        @relation(fields: [categorieId], references: [id])
  variantes   ProduitVariante[]
  venteLignes VenteLigne[]

  @@map("produits")
}

model ProduitVariante {
  id            Int      @id @default(autoincrement())
  produitId     Int      @map("produit_id")
  taille        String?  // Modèle, Dimension, ou Version
  couleur       String?  // Couleur, Finition ou Type
  reference     String?  @unique
  codeBarre     String?  @map("code_barre")
  prix          Float    @default(0.0)
  coutAchat     Float    @default(0.0) @map("cout_achat")
  quantiteStock Int      @default(0) @map("quantite_stock")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  produit          Produit          @relation(fields: [produitId], references: [id], onDelete: Cascade)
  stocksParPoint   StockParPoint[]
  venteLignes      VenteLigne[]
  achatLignes      AchatLigne[]
  factureLignes    FactureLigne[]
  mouvementsStock  StockMouvement[]
  transfertsLignes TransfertLigne[]

  @@map("produit_variantes")
}

model StockParPoint {
  id             Int      @id @default(autoincrement())
  varianteId     Int      @map("variante_id")
  pointDeVenteId Int      @map("point_de_vente_id")
  quantite       Int      @default(0)
  stockMin       Int      @default(3) @map("stock_min")
  updatedAt      DateTime @updatedAt @map("updated_at")

  variante     ProduitVariante @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  pointDeVente PointDeVente    @relation(fields: [pointDeVenteId], references: [id], onDelete: Cascade)

  @@unique([varianteId, pointDeVenteId])
  @@map("stock_par_point")
}

model TransfertStock {
  id                 Int      @id @default(autoincrement())
  reference          String   @unique
  pointOrigineId     Int      @map("point_origine_id")
  pointDestinationId Int      @map("point_destination_id")
  dateTransfert      DateTime @default(now()) @map("date_transfert")
  statut             String   @default("EN_ATTENTE") // EN_ATTENTE, EXPEDIE, VALIDE, REFUSE
  initieParId        Int?     @map("initie_par_id")
  valideParId        Int?     @map("valide_par_id")
  notes              String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  pointOrigine     PointDeVente     @relation("TransfertOrigine", fields: [pointOrigineId], references: [id])
  pointDestination PointDeVente     @relation("TransfertDestination", fields: [pointDestinationId], references: [id])
  initiePar        User?            @relation("TransfertInitiePar", fields: [initieParId], references: [id])
  validePar        User?            @relation("TransfertValidePar", fields: [valideParId], references: [id])
  lignes           TransfertLigne[]

  @@map("transferts_stock")
}

model TransfertLigne {
  id          Int   @id @default(autoincrement())
  transfertId Int   @map("transfert_id")
  varianteId  Int   @map("variante_id")
  nomArticle  String @map("nom_article")
  quantite    Int   @default(1)

  transfert TransfertStock  @relation(fields: [transfertId], references: [id], onDelete: Cascade)
  variante  ProduitVariante @relation(fields: [varianteId], references: [id])

  @@map("transfert_lignes")
}

model ClotureCaisse {
  id               Int      @id @default(autoincrement())
  reference        String   @unique
  pointDeVenteId   Int      @map("point_de_vente_id")
  dateCloture      DateTime @default(now()) @map("date_cloture")
  utilisateurId    Int      @map("utilisateur_id")
  totalEspeces     Float    @default(0.0) @map("total_especes")
  totalWave        Float    @default(0.0) @map("total_wave")
  totalOrangeMoney Float    @default(0.0) @map("total_orange_money")
  totalCarte       Float    @default(0.0) @map("total_carte")
  totalCredit      Float    @default(0.0) @map("total_credit")
  totalVentes      Float    @default(0.0) @map("total_ventes")
  totalDepenses    Float    @default(0.0) @map("total_depenses")
  soldeTheorique   Float    @default(0.0) @map("solde_theorique")
  soldeReel        Float    @default(0.0) @map("solde_reel")
  ecart            Float    @default(0.0)
  statut           String   @default("VALIDEE") // VALIDEE, AJUSTEE
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")

  pointDeVente PointDeVente @relation(fields: [pointDeVenteId], references: [id])
  utilisateur  User         @relation(fields: [utilisateurId], references: [id])

  @@map("clotures_caisse")
}

model Depense {
  id             Int      @id @default(autoincrement())
  pointDeVenteId Int      @map("point_de_vente_id")
  dateDepense    DateTime @default(now()) @map("date_depense")
  utilisateurId  Int?     @map("utilisateur_id")
  categorie      String   @default("DIVERS") // LOYER, ELECTRICITE, TRANSPORT, SALAIRE, DIVERS
  motif          String
  montant        Float    @default(0.0)
  modePaiement   String   @default("ESPECES") @map("mode_paiement")
  beneficiaire   String?
  justificatif   String?
  createdAt      DateTime @default(now()) @map("created_at")

  pointDeVente PointDeVente @relation(fields: [pointDeVenteId], references: [id])
  utilisateur  User?        @relation(fields: [utilisateurId], references: [id])

  @@map("depenses")
}

model Client {
  id           Int      @id @default(autoincrement())
  nom          String
  codeClient   String?  @map("code_client")
  telephone    String?
  email        String?
  adresse      String?
  ville        String?  @default("Bamako")
  soldeDette   Float    @default(0.0) @map("solde_dette")
  limiteCredit Float    @default(0.0) @map("limite_credit")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ventes    Vente[]
  paiements PaiementDette[]

  @@map("clients")
}

model Fournisseur {
  id              Int      @id @default(autoincrement())
  nom             String
  codeFournisseur String?  @map("code_fournisseur")
  telephone       String?
  email           String?
  adresse         String?
  ville           String?  @default("Bamako")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  achats Achat[]

  @@map("fournisseurs")
}

model Vente {
  id              Int      @id @default(autoincrement())
  reference       String   @unique
  dateVente       DateTime @default(now()) @map("date_vente")
  nomClient       String?  @map("nom_client")
  telephoneClient String?  @map("telephone_client")
  total           Float    @default(0.0)
  montantPaye     Float    @default(0.0) @map("montant_paye")
  montantRestant  Float    @default(0.0) @map("montant_restant")
  modePaiement    String   @default("ESPECES") @map("mode_paiement") // ESPECES, ORANGE_MONEY, WAVE, CARTE, CREDIT
  statutPaiement  String   @default("PAYE") @map("statut_paiement")   // PAYE, PARTIEL, IMPAYE
  typeVente       String   @default("DIRECT") @map("type_vente")
  clientId        Int?     @map("client_id")
  vendeurId       Int?     @map("vendeur_id")
  pointVenteId    Int      @map("point_vente_id")
  pointVenteNom   String?  @map("point_vente_nom")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  client         Client?         @relation(fields: [clientId], references: [id])
  vendeur        User?           @relation(fields: [vendeurId], references: [id])
  pointVente     PointDeVente    @relation(fields: [pointVenteId], references: [id])
  lignes         VenteLigne[]
  factures       Facture[]
  paiementsDette PaiementDette[]

  @@map("ventes")
}

model VenteLigne {
  id           Int      @id @default(autoincrement())
  venteId      Int      @map("vente_id")
  produitId    Int?     @map("produit_id")
  varianteId   Int?     @map("variante_id")
  nomProduit   String   @map("nom_produit")
  varianteInfo String?  @map("variante_info")
  quantite     Int      @default(1)
  prixUnitaire Float    @default(0.0) @map("prix_unitaire")
  coutUnitaire Float    @default(0.0) @map("cout_unitaire")
  totalLigne   Float    @default(0.0) @map("total_ligne")
  createdAt    DateTime @default(now()) @map("created_at")

  vente    Vente            @relation(fields: [venteId], references: [id], onDelete: Cascade)
  produit  Produit?         @relation(fields: [produitId], references: [id])
  variante ProduitVariante? @relation(fields: [varianteId], references: [id])

  @@map("vente_details")
}

model PaiementDette {
  id            Int      @id @default(autoincrement())
  clientId      Int      @map("client_id")
  venteId       Int?     @map("vente_id")
  montant       Float    @default(0.0)
  modePaiement  String   @default("ESPECES") @map("mode_paiement")
  datePaiement  DateTime @default(now()) @map("date_paiement")
  recuParId     Int?     @map("recu_par_id")
  referenceRecu String?  @map("reference_recu")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  client  Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vente   Vente? @relation(fields: [venteId], references: [id])
  recuPar User?  @relation(fields: [recuParId], references: [id])

  @@map("paiements_dette")
}

model Facture {
  id             Int      @id @default(autoincrement())
  numeroFacture  String   @unique @map("numero_facture")
  venteId        Int?     @map("vente_id")
  pointDeVenteId Int      @map("point_de_vente_id")
  utilisateurId  Int?     @map("utilisateur_id")
  dateFacture    DateTime @default(now()) @map("date_facture")
  totalFacture   Float    @default(0.0) @map("total_facture")
  statut         String   @default("PAYEE")
  pdfUrl         String?  @map("pdf_url")
  createdAt      DateTime @default(now()) @map("created_at")

  vente        Vente?         @relation(fields: [venteId], references: [id])
  pointDeVente PointDeVente   @relation(fields: [pointDeVenteId], references: [id])
  utilisateur  User?          @relation(fields: [utilisateurId], references: [id])
  lignes       FactureLigne[]

  @@map("factures")
}

model FactureLigne {
  id           Int      @id @default(autoincrement())
  factureId    Int      @map("facture_id")
  varianteId   Int?     @map("variante_id")
  description  String?
  quantite     Int      @default(1)
  prixUnitaire Float    @default(0.0) @map("prix_unitaire")
  totalLigne   Float    @default(0.0) @map("total_ligne")

  facture  Facture          @relation(fields: [factureId], references: [id], onDelete: Cascade)
  variante ProduitVariante? @relation(fields: [varianteId], references: [id])

  @@map("facture_lignes")
}

model Achat {
  id             Int      @id @default(autoincrement())
  reference      String?
  dateAchat      DateTime @default(now()) @map("date_achat")
  fournisseurId  Int?     @map("fournisseur_id")
  fournisseurNom String?  @map("fournisseur_nom")
  telephone      String?
  adresse        String?
  totalAchat     Float    @default(0.0) @map("total_achat")
  statut         String   @default("RECU")
  utilisateurId  Int?     @map("utilisateur_id")
  pointDeVenteId Int?     @map("point_de_vente_id")
  createdAt      DateTime @default(now()) @map("created_at")

  fournisseur  Fournisseur?   @relation(fields: [fournisseurId], references: [id])
  utilisateur  User?          @relation(fields: [utilisateurId], references: [id])
  pointDeVente PointDeVente?  @relation(fields: [pointDeVenteId], references: [id])
  lignes       AchatLigne[]

  @@map("achats")
}

model AchatLigne {
  id           Int      @id @default(autoincrement())
  achatId      Int      @map("achat_id")
  varianteId   Int?     @map("variante_id")
  produitNom   String?  @map("produit_nom")
  quantite     Int      @default(1)
  prixUnitaire Float    @default(0.0) @map("prix_unitaire")
  totalLigne   Float    @default(0.0) @map("total_ligne")

  achat    Achat            @relation(fields: [achatId], references: [id], onDelete: Cascade)
  variante ProduitVariante? @relation(fields: [varianteId], references: [id])

  @@map("achat_lignes")
}

model StockMouvement {
  id             Int      @id @default(autoincrement())
  varianteId     Int      @map("variante_id")
  pointDeVenteId Int      @map("point_de_vente_id")
  typeMouvement  String   @map("type_mouvement") // VENTE, ACHAT, TRANSFERT_ENTRANT, TRANSFERT_SORTANT, AJUSTEMENT
  quantite       Int
  stockAvant     Int      @default(0) @map("stock_avant")
  stockApres     Int      @default(0) @map("stock_apres")
  motif          String?
  referenceDoc   String?  @map("reference_doc")
  utilisateurId  Int?     @map("utilisateur_id")
  dateMouvement  DateTime @default(now()) @map("date_mouvement")
  createdAt      DateTime @default(now()) @map("created_at")

  variante     ProduitVariante @relation(fields: [varianteId], references: [id], onDelete: Cascade)
  pointDeVente PointDeVente    @relation(fields: [pointDeVenteId], references: [id])
  utilisateur  User?           @relation(fields: [utilisateurId], references: [id])

  @@map("mouvements_stock")
}
